[user]
	name = John Kunze
	email = 105020+jkunze@users.noreply.github.com
[core]
	editor = vim
	pager = less
[color]
	ui = true
[color "diff"]
	new = bold yellow
[push]
	default = simple
[alias]
	alias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
	list  = branch -a
    # Add another -m option to add a longer description in the body
	chi   = commit -a -v -m
	cho   = checkout
	df    = diff HEAD
	lg    = log --decorate
	lp    = log --decorate --patch
	lf    = log --name-status
    ll    = log --pretty=format:"%h %ad %an%x09%s" --date=short
	st    = status -sb
	incoming = ! git fetch && git lg ..origin/main
	outgoing = ! git fetch && git lg origin/main..
    # Sync upstream main into local main and reset the work branch
    sync = ! git checkout main && git pull upstream main && git push origin main && git checkout -B work
    # Safely force-push the recycled work branch up to my GH fork
    up = push --force-with-lease
    # Open a Pull Request to upstream using existing commit messages
    pr = !gh pr create --fill
    # Uncommit the last local change but keep local file edits intact; "git up" to overwrite
    undo = reset --soft HEAD~1
    # to "save" use "git chi ... && git push -f"
[init]
	defaultBranch = main
[includeIf "gitdir:~/arka/"]
	path = ~/arka/.gitconfig

